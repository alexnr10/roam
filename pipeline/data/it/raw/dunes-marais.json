{"admin_qid": null, "article_bytes": 6556, "commons_category": "Laguna di Grado", "commune_code": "031009", "commune_name": "Grado", "departement_code": "031", "dissolved": null, "elevation_m": null, "excluded_class": "", "geo_rescued": false, "has_frwiki": true, "image_author": "LagunareG", "image_credit_for": "File:Gradolagoon.jpg", "image_licence": "CC BY-SA 3.0", "image_url": "http://commons.wikimedia.org/wiki/Special:FilePath/Gradolagoon.jpg", "inclusion_criteria": [], "kept_in_review": false, "labels": [], "lat": 45.708, "lon": 13.352, "name": "Lagune de Grado", "opening_hours": null, "osm_id": null, "pageviews_per_month": 38, "pinned": false, "pinned_by_hand": false, "promotion_double": false, "region_code": "06", "score": 0.0, "sitelinks": 9, "source": "wikidata", "summary": "La lagune de Grado est une lagune de la mer Adriatique située sur le territoire de la commune de Grado (Italie), en Frioul-Vénétie Julienne. S'étendant sur une superficie d'environ 90 kilomètres carrés,  entre la pointe de Grado à l'est et l'île d'Anfora à l'ouest, à  l'embouchure des fleuves Ausa et Corno, elle est divisée en un secteur oriental (palù de sora) et un secteur occidental (palù de soto) où une digue-route relie Grado à la terre ferme, tandis qu'à l'ouest s'étend la lagune de Marano.", "theme_id": "dunes-marais", "tier_shift": 0, "validation_radius_m": 600, "via_broad_class": false, "visitable": null, "visitors_per_year": null, "website": null, "wikidata_id": "Q2258312", "wikipedia_url": "https://fr.wikipedia.org/wiki/Lagune_de_Grado"},
