{
  "expo": {
    "name": "Roam",
    "slug": "roam",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "roam",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EAD8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.roam.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Roam utilise ta position pour valider les lieux où tu te trouves et t'indiquer ceux à visiter aux alentours."
      }
    },
    "android": {
      "package": "app.roam.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5EAD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Roam utilise ta position pour valider les lieux où tu te trouves et t'indiquer ceux à visiter aux alentours."
        }
      ]
    ],
    "extra": {
      "router": {},
      "catalogues": "v0.1-france",
      "eas": {
        "projectId": "06bf47d0-7170-4b76-abf1-25b69075f395"
      }
    }
  }
}
