{
  "name": "roam",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "export:web": "node scripts/sync-maplibre-worker.mjs && EXPO_OFFLINE=1 expo export --platform web --output-dir dist",
    "preview:single": "npm run export:web && node scripts/inline-web-build.mjs",
    "postinstall": "node scripts/sync-maplibre-worker.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "maplibre-gl": "^6.5.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-maps": "1.29.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ]
  }
}
